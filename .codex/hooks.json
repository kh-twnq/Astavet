{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/harness/scripts/hook.py\"",
            "timeout": 10,
            "statusMessage": "Task snapshot"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/harness/scripts/hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking workspace guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/harness/scripts/hook.py\"",
            "timeout": 10,
            "statusMessage": "Verification reminder"
          }
        ]
      }
    ]
  }
}
