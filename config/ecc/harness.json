{
  "version": 1,
  "upstreamManifest": "tools/ecc/manifest.json",
  "baselineRules": [
    "docs/ecc/rules/common/coding-style.md",
    "docs/ecc/rules/common/security.md",
    "docs/ecc/rules/common/testing.md"
  ],
  "roles": {
    "explorer": ".codex/agents/explorer.toml",
    "java_reviewer": ".codex/agents/java_reviewer.toml",
    "java_build_resolver": ".codex/agents/java_build_resolver.toml",
    "security_reviewer": ".codex/agents/security_reviewer.toml",
    "harness_optimizer": ".codex/agents/harness_optimizer.toml"
  },
  "checks": {
    "ecc": [
      "bash",
      "scripts/verify.sh",
      "ecc"
    ],
    "backend": [
      "bash",
      "scripts/verify.sh",
      "backend"
    ],
    "frontend": [
      "bash",
      "scripts/verify.sh",
      "frontend"
    ],
    "integration": [
      "bash",
      "scripts/verify.sh",
      "integration"
    ]
  },
  "phases": [
    {
      "id": "inspect",
      "dependsOn": []
    },
    {
      "id": "implement",
      "dependsOn": [
        "inspect"
      ]
    },
    {
      "id": "verify",
      "dependsOn": [
        "implement"
      ]
    }
  ],
  "routes": [
    {
      "id": "java",
      "patterns": [
        "backend/**/*.java",
        "backend/*.gradle",
        "backend/**/*.properties",
        "backend/**/*.yml"
      ],
      "rules": [
        "docs/ecc/rules/java/coding-style.md",
        "docs/ecc/rules/java/security.md"
      ],
      "skills": [
        "java-coding-standards"
      ],
      "roles": [
        "java_reviewer",
        "java_build_resolver"
      ],
      "checks": [
        "backend"
      ],
      "optionalSkills": [
        {
          "name": "springboot-tdd",
          "when": "Adding or changing behavior, fixing a bug, or changing tests."
        },
        {
          "name": "springboot-patterns",
          "when": "Introducing or changing Spring architecture, service boundaries, caching or async behavior."
        },
        {
          "name": "springboot-verification",
          "when": "Deep verification requested, release preparation, or major framework/dependency changes."
        }
      ]
    },
    {
      "id": "java_tests",
      "patterns": [
        "backend/src/test/**/*.java"
      ],
      "rules": [
        "docs/ecc/rules/java/testing.md"
      ],
      "skills": [
        "springboot-tdd"
      ],
      "roles": [
        "java_reviewer"
      ],
      "checks": [
        "backend"
      ]
    },
    {
      "id": "persistence",
      "patterns": [
        "backend/**/entity/**/*.java",
        "backend/**/repository/**/*.java",
        "backend/**/service/**/*.java"
      ],
      "rules": [],
      "skills": [
        "jpa-patterns"
      ],
      "roles": [
        "java_reviewer"
      ],
      "checks": [
        "integration"
      ],
      "optionalSkills": [
        {
          "name": "postgres-patterns",
          "when": "Changing queries/indexes, database permissions, locking or database performance."
        }
      ]
    },
    {
      "id": "api",
      "patterns": [
        "backend/**/controller/**/*.java",
        "backend/**/dto/**/*.java"
      ],
      "rules": [],
      "skills": [
        "api-design"
      ],
      "roles": [
        "security_reviewer"
      ],
      "checks": [
        "backend"
      ],
      "optionalSkills": [
        {
          "name": "security-review",
          "when": "Adding input processing, sensitive data exposure, auth or payment API behavior."
        }
      ]
    },
    {
      "id": "migration",
      "patterns": [
        "backend/**/db/migration/*.sql"
      ],
      "rules": [],
      "skills": [
        "database-migrations",
        "postgres-patterns"
      ],
      "roles": [
        "java_reviewer"
      ],
      "checks": [
        "backend",
        "integration"
      ]
    },
    {
      "id": "security",
      "patterns": [
        "backend/**/config/*.java",
        "backend/**/auth/**/*.java"
      ],
      "rules": [
        "docs/ecc/rules/java/security.md"
      ],
      "skills": [
        "springboot-security"
      ],
      "roles": [
        "security_reviewer"
      ],
      "checks": [
        "backend"
      ],
      "optionalSkills": [
        {
          "name": "security-review",
          "when": "Cross-cutting security audit, secret handling, payment behavior or threat analysis."
        }
      ]
    },
    {
      "id": "frontend",
      "patterns": [
        "frontend/**"
      ],
      "rules": [],
      "skills": [
        "verification-loop"
      ],
      "roles": [
        "explorer"
      ],
      "checks": [
        "frontend"
      ],
      "optionalSkills": [
        {
          "name": "tdd-workflow",
          "when": "Adding or changing frontend behavior, fixing a bug, or changing tests."
        }
      ]
    },
    {
      "id": "harness",
      "patterns": [
        ".codex/**",
        ".agents/**",
        "AGENTS.md",
        "**/AGENTS.md",
        "scripts/**",
        "tools/ecc/**",
        "docs/ecc/**",
        ".github/**",
        "config/ecc/**"
      ],
      "rules": [],
      "skills": [
        "agent-harness-construction"
      ],
      "roles": [
        "harness_optimizer"
      ],
      "checks": [
        "ecc"
      ],
      "optionalSkills": [
        {
          "name": "eval-harness",
          "when": "Evaluating or benchmarking agent behavior, model prompts or regression reliability."
        }
      ]
    }
  ]
}
