{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-state",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "start",
        "implement",
        "verify",
        "blocked",
        "ready_to_ship",
        "shipped"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "head": {},
            "branch": {
              "type": "string"
            },
            "tree": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "100644",
                      "100755",
                      "120000"
                    ]
                  },
                  "oid": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "mode",
                  "oid"
                ],
                "additionalProperties": false
              }
            },
            "index": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "head",
            "branch",
            "tree",
            "index",
            "profile",
            "fingerprint"
          ],
          "additionalProperties": false
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exit_code": {
                "type": "integer"
              },
              "output_sha256": {
                "type": "string",
                "minLength": 1
              },
              "timed_out": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "argv",
              "exit_code",
              "output_sha256",
              "timed_out"
            ],
            "additionalProperties": false
          }
        },
        "secret_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "category": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "line",
              "category"
            ],
            "additionalProperties": false
          }
        },
        "unchanged": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "created_at",
        "snapshot",
        "commands",
        "secret_findings",
        "unchanged",
        "passed"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "verdict",
        "summary",
        "fingerprint",
        "created_at"
      ],
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "created_at"
      ],
      "additionalProperties": false
    },
    "ship": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "head",
        "created_at"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "workflow": {
          "type": "string",
          "enum": [
            "ticket",
            "bugfix",
            "release"
          ]
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "planned_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "results": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "blocked"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "type": "string",
                "minLength": 1
              },
              "created_at": {
                "type": "string",
                "minLength": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "repo_fingerprints": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "node",
              "status",
              "summary",
              "fingerprint",
              "created_at",
              "attempt"
            ],
            "additionalProperties": false
          }
        },
        "attempts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "retry_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "created_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "node",
              "reason",
              "created_at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "workflow",
        "repos",
        "planned_nodes",
        "results",
        "attempts",
        "retry_reasons"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "task_id",
    "objective",
    "base",
    "phase",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
