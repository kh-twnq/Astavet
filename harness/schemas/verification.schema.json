{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "head": {},
        "branch": {
          "type": "string"
        },
        "tree": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "100644",
                  "100755",
                  "120000"
                ]
              },
              "oid": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "mode",
              "oid"
            ],
            "additionalProperties": false
          }
        },
        "index": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "head",
        "branch",
        "tree",
        "index",
        "profile",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exit_code": {
            "type": "integer"
          },
          "output_sha256": {
            "type": "string",
            "minLength": 1
          },
          "timed_out": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "argv",
          "exit_code",
          "output_sha256",
          "timed_out"
        ],
        "additionalProperties": false
      }
    },
    "secret_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "line",
          "category"
        ],
        "additionalProperties": false
      }
    },
    "unchanged": {
      "type": "boolean"
    },
    "passed": {
      "type": "boolean"
    }
  },
  "required": [
    "created_at",
    "snapshot",
    "commands",
    "secret_findings",
    "unchanged",
    "passed"
  ],
  "additionalProperties": false
}
