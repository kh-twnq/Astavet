{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflow": {
      "type": "string",
      "enum": [
        "ticket",
        "bugfix",
        "release"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "enum": [
              "always",
              "security",
              "cross_repo_contract",
              "code_change"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "maximum_attempts": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "skill",
          "condition",
          "dependencies",
          "maximum_attempts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "workflow",
    "description",
    "nodes"
  ],
  "additionalProperties": false
}
